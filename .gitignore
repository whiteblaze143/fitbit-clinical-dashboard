# Fitbit Clinical Dashboard - Git Ignore Rules

# ============================================================================
# SENSITIVE DATA - NEVER COMMIT THESE
# ============================================================================

# Fitbit tokens (contains OAuth credentials)
fitbit/tokens/
fitbit/token_store.json
*.json

# Participant data exports
fitbit_exports/
exports/
data/

# Configuration with credentials
fitbit/config.py
config.py
.env
*.env

# Participant registry (contains PHI)
participants.csv
fitbit/participants.csv

